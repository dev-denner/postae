# Postaê — env de exemplo
# Copie para .env e ajuste. Em produção, use um gerenciador de segredos.
# Nunca commite valores reais de tokens, senhas ou chaves.

# ---- App ----
PORT=3001
NODE_ENV=development

# Limites de requisição (throttler global da API)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---- Banco / fila ----
DATABASE_URL=postgresql://postae:postae@localhost:5432/postae
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Tokens e criptografia ----
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=troque-por-32-bytes-em-base64
JWT_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_TTL=15m

# ---- Frontend ----
# URL pública do frontend (usada em CORS da API e redirecionamento OAuth)
FRONTEND_URL=http://localhost:5173
# URL pública da API (usada pelo frontend via Vite)
VITE_API_URL=http://localhost:3001

# ---- Upload de mídia / storage ----
# Diretório persistente dos uploads locais. No Docker Compose o valor é
# sobrescrito para /app/uploads e montado em um volume nomeado.
UPLOAD_DIR=./uploads
# Base pública da API usada nas URLs assinadas de mídia.
# Em dev local pode ficar vazio (preview relativo). Instagram e Threads
# exigem uma URL absoluta acessível pela internet para buscar a mídia;
# nesse caso configure um domínio/túnel HTTPS público.
MEDIA_PUBLIC_BASE_URL=
# Segredo HMAC das URLs de mídia. Se vazio, usa ENCRYPTION_KEY.
MEDIA_SIGNING_SECRET=
# Validade das URLs assinadas (segundos)
MEDIA_PREVIEW_TTL_SECONDS=86400
MEDIA_PUBLISH_TTL_SECONDS=3600
# Limites de upload por tipo de arquivo (MB)
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=200

# ---- OAuth das redes sociais ----
# Base pública da API para callbacks OAuth (ex: https://api.exemplo.com ou http://localhost:3001)
# Deve terminar ou conter /api; o caminho /social/oauth/:provider/callback é acrescido automaticamente.
OAUTH_CALLBACK_BASE=http://localhost:3001

# Instagram / Facebook (Meta Graph)
META_GRAPH_VERSION=v26.0
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Threads
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# X (Twitter) — OAuth 2.0 com PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok — Content Posting API (client_key aceita TIKTOK_CLIENT_KEY ou TIKTOK_CLIENT_ID)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# YouTube — Data API v3 / OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=public
