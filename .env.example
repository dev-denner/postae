# Postaê — env de exemplo
# Copie para .env e ajuste. Em produção, use um gerenciador de segredos.

# ---- App ----
PORT=3001
NODE_ENV=development
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---- Banco / fila / storage ----
DATABASE_URL=postgresql://postae:postae@localhost:5432/postae
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=postae-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio1234
S3_FORCE_PATH_STYLE=true

# ---- Tokens ----
JWT_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# ---- OAuth das redes (opcional p/ modo mock) ----
OAUTH_CALLBACK_BASE=http://localhost:3001
META_CALLBACK_BASE=http://localhost:3001
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
