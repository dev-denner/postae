# Apenas pacotes confiáveis e necessários podem rodar scripts de instalação.
# O /mnt/Dados está em NTFS (fmask remove bits de execução), então binários
# em node_modules/.bin não são executáveis diretos; os scripts do package.json
# invocam o JS subjacente via node. Ainda assim, pacotes como prisma e esbuild
# precisam de scripts de pós-instalação (download de engines/binários).
allow-scripts=prisma,@prisma/client,@prisma/engines,esbuild,msgpackr-extract,@nestjs/core
